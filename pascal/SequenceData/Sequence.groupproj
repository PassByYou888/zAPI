<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{10DF9C2B-B6F9-4179-9765-3D62688E469A}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Sequence_Serv.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Squence_Cli.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="Sequence_Serv">
        <MSBuild Projects="Sequence_Serv.dproj"/>
    </Target>
    <Target Name="Sequence_Serv:Clean">
        <MSBuild Projects="Sequence_Serv.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Sequence_Serv:Make">
        <MSBuild Projects="Sequence_Serv.dproj" Targets="Make"/>
    </Target>
    <Target Name="Squence_Cli">
        <MSBuild Projects="Squence_Cli.dproj"/>
    </Target>
    <Target Name="Squence_Cli:Clean">
        <MSBuild Projects="Squence_Cli.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Squence_Cli:Make">
        <MSBuild Projects="Squence_Cli.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="Sequence_Serv;Squence_Cli"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="Sequence_Serv:Clean;Squence_Cli:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="Sequence_Serv:Make;Squence_Cli:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>

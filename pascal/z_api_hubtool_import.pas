{-------------------------------------------------------------------------------
  API_ReadString – 扫描 #0 终止符并解码 UTF‑8
-------------------------------------------------------------------------------}
function API_ReadString(Hnd: TDataHnd; out Value: string): boolean;
type
  TByteArray = array [0..0] of byte;
  PByteArray = ^TByteArray;
var
  p: PByteArray;
  b, e, sz: int64;
  Buff: TBytes;
begin
  p := API_GetBuffer(Hnd);
  sz := API_GetSize(Hnd);
  if (p = nil) or (sz = 0) then
  begin
    Value := '';
    Result := False;
    Exit;
  end;
  b := API_GetPos(Hnd);
  if b >= sz then
  begin
    Value := '';
    Result := False;
    Exit;
  end;
  e := b;
  while (e < sz) and (p^[e] <> 0) do
    Inc(e);
  if e = sz then  // 未找到终止符
  begin
    Value := '';
    Result := False;
    Exit;
  end;
  SetLength(Buff, e - b);
  if e > b then
    Move(p^[b], Buff[0], e - b);
  API_SetPos(Hnd, e + 1);
  Value := TEncoding.utf8.GetString(Buff);
  Result := True;
end;

function API_ReadString(Hnd: TDataHnd): string;
begin
  API_ReadString(Hnd, Result);
end;


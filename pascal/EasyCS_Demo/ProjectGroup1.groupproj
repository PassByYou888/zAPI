            <Dependencies/>
        </Projects>
        <Projects Include="vclEasyServer\vclEasyServer.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="EasyServer">
        <MSBuild Projects="EasyServer.dproj"/>
    </Target>
    <Target Name="EasyServer:Clean">
        <MSBuild Projects="EasyServer.dproj" Targets="Clean"/>
    </Target>
    <Target Name="EasyServer:Make">
        <MSBuild Projects="EasyServer.dproj" Targets="Make"/>
    </Target>
    <Target Name="EasyClient">
        <MSBuild Projects="EasyClient.dproj"/>
    </Target>
    <Target Name="EasyClient:Clean">
        <MSBuild Projects="EasyClient.dproj" Targets="Clean"/>
    </Target>
    <Target Name="EasyClient:Make">
        <MSBuild Projects="EasyClient.dproj" Targets="Make"/>
    </Target>
    <Target Name="fmxclient">
        <MSBuild Projects="fmxcient\fmxclient.dproj"/>
    </Target>
    <Target Name="fmxclient:Clean">
        <MSBuild Projects="fmxcient\fmxclient.dproj" Targets="Clean"/>
    </Target>
    <Target Name="fmxclient:Make">
        <MSBuild Projects="fmxcient\fmxclient.dproj" Targets="Make"/>
